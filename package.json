{
  "name": "monsterland-panel",
  "version": "0.1.0",
  "private": true,
  "description": "Panel de torneos de Monsterland: inscripciones, llaves, resultados, ranking de temporada y caja.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preparar": "node scripts/preparar.mjs",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "seed": "node --env-file-if-exists=.env dist/seed.js",
    "demo": "npm run preparar && npm run build && npm run seed && npm start",
    "test": "vitest --run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
