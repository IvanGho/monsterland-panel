# Copiá este archivo como .env y completá los valores, o corré: npm run preparar
# El .env NO se sube a GitHub (está en .gitignore).
#
# Nada de esto es obligatorio para arrancar: sin ninguna variable, el panel funciona en
# modo demo con los datos en memoria. Lo de abajo es para usarlo en serio.

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Sin esto, los datos viven en memoria y se borran (modo demo).
# Sirve cualquier Postgres: Neon, Supabase, Railway, o uno propio.
# En Vercel: Storage -> Create Database -> Postgres, y la variable se carga sola.
# DATABASE_URL=postgres://usuario:clave@host:5432/basededatos

# ---------------------------------------------------------------------------
# Acceso
# ---------------------------------------------------------------------------
# Obligatorias en cuanto haya DATABASE_URL: si hay datos reales, no se abre sin clave.
# En modo demo se ignoran y las claves son "demo" y "demo-mod".
ADMIN_PASSWORD=
MOD_PASSWORD=

# Firma las cookies de sesión. Si falta, se genera una al azar en cada arranque, así que
# te va a desloguear seguido. Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Opcionales
# ---------------------------------------------------------------------------
PORT=3000
NOMBRE_COMUNIDAD=Monsterland

# Sólo para mostrar equivalencias en dólares en el panel. Se actualiza a mano.
TIPO_CAMBIO_ARS=1520
TIPO_CAMBIO_FECHA=07/08/2026

# Porcentaje del SALDO mensual (ingresos - egresos) que se lleva el moderador.
# 0.15 = 15%. Si el mes cierra en rojo, el cálculo da 0.
PORCENTAJE_MOD=0.15
