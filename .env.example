# Copiá este archivo como .env y completá los valores.
# El .env NO se sube a GitHub (está en .gitignore): son tus claves.

# Clave del dueño (puede todo: crear temporadas, pagar premios, borrar movimientos de caja).
ADMIN_PASSWORD=cambiame-por-algo-largo

# Clave del moderador (opera torneos, cobra inscripciones, carga resultados).
# Tiene que ser distinta de la del admin.
MOD_PASSWORD=cambiame-tambien

# Secreto para firmar la cookie de sesión. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Puerto en el que escucha el panel (se ignora en Vercel).
PORT=3000

# ---------------------------------------------------------------------------
# Base de datos: elegí UNA de las dos opciones.
# ---------------------------------------------------------------------------

# OPCIÓN A — Archivo local (tu PC, o un server con disco persistente).
# Es la opción por defecto y no necesita cuenta en ningún servicio.
DB_PATH=./data/monsterland.db

# OPCIÓN B — Base libSQL/Turso por red. OBLIGATORIA en Vercel: allá el disco se
# descarta en cada deploy, así que una base en archivo se borraría sola.
# Si TURSO_DATABASE_URL está definida, se ignora DB_PATH.
#   npm i -g @tursodatabase/turso-cli   (o: brew install tursodatabase/tap/turso)
#   turso auth signup
#   turso db create monsterland
#   turso db show monsterland --url        -> TURSO_DATABASE_URL
#   turso db tokens create monsterland     -> TURSO_AUTH_TOKEN
# TURSO_DATABASE_URL=libsql://monsterland-tuusuario.turso.io
# TURSO_AUTH_TOKEN=

# Sólo para mostrar equivalencias en dólares en el panel. Actualizalo a mano cuando quieras.
TIPO_CAMBIO_ARS=1520
TIPO_CAMBIO_FECHA=07/08/2026

# Porcentaje del SALDO mensual (ingresos - egresos) que se lleva el moderador.
# 0.15 = 15%. Si el mes cierra en rojo, el cálculo da 0.
PORCENTAJE_MOD=0.15

NOMBRE_COMUNIDAD=Monsterland
