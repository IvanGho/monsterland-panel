# Copiá este archivo como .env y completá los valores.
# El .env NO se sube a GitHub (está en .gitignore): son tus claves.

# Clave del dueño (puede todo: crear temporadas, pagar premios, borrar movimientos de caja).
ADMIN_PASSWORD=cambiame-por-algo-largo

# Clave del moderador (opera torneos, cobra inscripciones, carga resultados).
# Tiene que ser distinta de la del admin.
MOD_PASSWORD=cambiame-tambien

# Secreto para firmar la cookie de sesión. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Puerto en el que escucha el panel.
PORT=3000

# Dónde se guarda la base SQLite. En un servidor con disco persistente, apuntalo al volumen.
DB_PATH=./data/monsterland.db

# Sólo para mostrar equivalencias en dólares en el panel. Actualizalo a mano cuando quieras.
TIPO_CAMBIO_ARS=1520
TIPO_CAMBIO_FECHA=07/08/2026

# Porcentaje del SALDO mensual (ingresos - egresos) que se lleva el moderador.
# 0.15 = 15%. Si el mes cierra en rojo, el cálculo da 0.
PORCENTAJE_MOD=0.15

NOMBRE_COMUNIDAD=Monsterland
